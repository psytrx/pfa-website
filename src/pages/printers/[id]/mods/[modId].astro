---
import { getCollection } from "astro:content";
import { marked } from "marked";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { LinkButton, LinkCard } from "@astrojs/starlight/components";

export async function getStaticPaths() {
  const printers = await getCollection("printers");
  const printerMap = new Map(printers.map((p) => [p.id, p.data.title]));
  const allMods = await getCollection("printer-mods");

  return allMods.map((mod) => ({
    params: { id: mod.data.printerId, modId: mod.data.id },
    props: {
      mod: mod.data,
      printerTitle: printerMap.get(mod.data.printerId) || mod.data.printerId,
    },
  }));
}

const { mod, printerTitle } = Astro.props;

const rawBase = mod.githubUrl
  .replace("github.com", "raw.githubusercontent.com")
  .replace("/tree/", "/");

marked.use({
  walkTokens(token) {
    if (token.type === "image" && !/^https?:\/\//.test(token.href)) {
      token.href = `${rawBase}/${token.href.replace(/^\.\//, "")}`;
    }
  },
});

const html =
  mod.readme && mod.readmeExtension === "md" ? marked(mod.readme) : null;
---

<StarlightPage frontmatter={{ title: mod.name }}>
  <div class="flex flex-col items-start gap-4 mb-6">
    {mod.author && <p class="m-0 text-gray-2">by {mod.author}</p>}

    <LinkButton href={mod.githubUrl} icon="github" target="_blank">
      View files on GitHub
    </LinkButton>
  </div>

  {
    html ? (
      <div class="mod-readme" set:html={html} />
    ) : mod.readme ? (
      <pre class="whitespace-pre-wrap text-sm">{mod.readme}</pre>
    ) : (
      <p class="text-gray-3 italic">No description available.</p>
    )
  }

  <div class="mt-8 pt-4 border-t border-gray-5">
    <LinkCard
      href={`/printers/${mod.printerId}/mods/`}
      title={`Back to ${printerTitle} Mods`}
    />
  </div>
</StarlightPage>

<style>
  .mod-readme :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 0.25rem;
  }

  .mod-readme :global(h1) {
    font-size: var(--sl-text-h3);
  }

  .mod-readme :global(h2) {
    font-size: var(--sl-text-h4);
  }
</style>
