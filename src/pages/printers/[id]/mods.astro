---
import { getCollection } from "astro:content";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import ModGrid from "../../../components/ModGrid.astro";
import { LinkButton } from "@astrojs/starlight/components";

export async function getStaticPaths() {
  const printers = await getCollection("printers");
  const modSources = await getCollection("mod-sources");
  const printersById = new Map(
    printers.map((printer) => [printer.id, printer]),
  );

  return modSources.map((source) => {
    const printer = printersById.get(source.id);
    if (!printer) {
      throw new Error(`Mod source references unknown printer: ${source.id}`);
    }

    return {
      params: { id: printer.id },
      props: {
        printerId: printer.id,
        title: printer.data.title,
        repo: source.data.repo,
      },
    };
  });
}

const { printerId, title, repo } = Astro.props;

const allMods = await getCollection("printer-mods");
const mods = allMods
  .filter((m) => m.data.printerId === printerId)
  .sort((a, b) => {
    if (a.data.author && b.data.author) {
      const cmp = a.data.author.localeCompare(b.data.author);
      if (cmp !== 0) return cmp;
    }
    return a.data.name.localeCompare(b.data.name);
  })
  .map((m) => ({
    id: m.data.id,
    name: m.data.name,
    author: m.data.author,
    description: m.data.description,
    thumbnail: m.data.thumbnail,
  }));
---

<StarlightPage frontmatter={{ title: `${title} Mods` }}>
  <div class="space-y-8">
    <p>
      Community-contributed modifications for the {title}.
    </p>

    <LinkButton
      href={`https://github.com/${repo}`}
      icon="github"
      target="_blank"
      variant="secondary"
    >
      View on GitHub
    </LinkButton>

    <ModGrid printerId={printerId} mods={mods} />
  </div>
</StarlightPage>
