---
import { getCollection } from "astro:content";
import { renderMarkdownWithRelativeImages } from "../../../utils/markdown";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { LinkButton } from "@astrojs/starlight/components";

const GITHUB_RAW = "https://raw.githubusercontent.com";

export async function getStaticPaths() {
  const printers = await getCollection("printers");
  return printers.map((p) => ({
    params: { id: p.id },
    props: {
      title: p.data.title,
      github: p.data.github,
      developer: new URL(p.data.github.url).pathname
        .split("/")
        .filter(Boolean)[0],
    },
  }));
}

const { title, github, developer } = Astro.props;

const [owner, name] = new URL(github.url).pathname
  .replace(/^\/+/, "")
  .split("/");
const rawBase = `${GITHUB_RAW}/${owner}/${name}/${github.branch}`;

const readmeUrl = `${rawBase}/${github.readme}`;
const readmeRes = await fetch(readmeUrl);
if (!readmeRes.ok) {
  throw new Error(`README.md could not be loaded: ${readmeRes.statusText}`, {
    cause: readmeUrl,
  });
}

const readme = await readmeRes.text();

const html = readme ? renderMarkdownWithRelativeImages(readme, rawBase) : null;
---

<StarlightPage frontmatter={{ title }}>
  <div class="space-y-8">
    <LinkButton
      href={github.url}
      icon="github"
      target="_blank"
      variant="primary"
    >
      View on GitHub
    </LinkButton>

    <p class="text-sm text-(--sl-color-gray-3)">
      Developer: <a href={`https://github.com/${developer}`}>{developer}</a>
    </p>

    {
      html ? (
        <div set:html={html} />
      ) : (
        <p class="text-(--sl-color-gray-3) italic">
          README.md could not be loaded.
        </p>
      )
    }
  </div>
</StarlightPage>

<style>
  .printer-readme :global(img) {
    max-width: 100%;
    height: auto;
  }
</style>
