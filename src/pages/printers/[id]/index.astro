---
import { getCollection } from "astro:content";
import { marked } from "marked";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { LinkButton } from "@astrojs/starlight/components";

const GITHUB_RAW = "https://raw.githubusercontent.com";

export async function getStaticPaths() {
  const printers = await getCollection("printers");
  return printers.map((p) => ({
    params: { id: p.id },
    props: {
      title: p.data.title,
      repo: p.data.github.url,
      branch: p.data.github.branch,
    },
  }));
}

const { title, repo, branch } = Astro.props;

const [owner, name] = new URL(repo).pathname.replace(/^\/+/, "").split("/");
const rawBase = `${GITHUB_RAW}/${owner}/${name}/${branch}`;

const readmeUrl = `${rawBase}/README.md`;
const readmeRes = await fetch(readmeUrl);
const readme = readmeRes.ok ? await readmeRes.text() : null;

marked.use({
  walkTokens(token) {
    if (token.type === "image" && !/^https?:\/\//.test(token.href)) {
      const relative = token.href.replace(/^\.\//, "");
      token.href = `${rawBase}/${relative}`;
    }
  },
});

const html = readme ? marked(readme) : null;
---

<StarlightPage frontmatter={{ title }}>
  <div class="space-y-8">
    <LinkButton href={repo} icon="github" target="_blank" variant="secondary">
      View on GitHub
    </LinkButton>

    {
      html ? (
        <div set:html={html} />
      ) : (
        <p class="text-(--sl-color-gray-3) italic">
          README could not be loaded.
        </p>
      )
    }
  </div>
</StarlightPage>

<style>
  .printer-readme :global(img) {
    max-width: 100%;
    height: auto;
  }
</style>
