---
import { getCollection } from "astro:content";
import { marked } from "marked";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { LinkButton, LinkCard } from "@astrojs/starlight/components";

const GITHUB_RAW = "https://raw.githubusercontent.com";

export async function getStaticPaths() {
  const printers = await getCollection("printers");
  return printers.map((p) => ({
    params: { id: p.id },
    props: {
      id: p.id,
      title: p.data.title,
      repo: p.data.link,
      branch: p.data.branch,
      hasMods: !!p.data.mods,
    },
  }));
}

const { id, title, repo, branch, hasMods } = Astro.props;

const [owner, name] = new URL(repo).pathname.replace(/^\/+/, "").split("/");
const rawBase = `${GITHUB_RAW}/${owner}/${name}/${branch}`;

const readmeUrl = `${rawBase}/README.md`;
const readmeRes = await fetch(readmeUrl);
const readme = readmeRes.ok ? await readmeRes.text() : null;

marked.use({
  walkTokens(token) {
    if (token.type === "image" && !/^https?:\/\//.test(token.href)) {
      const relative = token.href.replace(/^\.\//, "");
      token.href = `${rawBase}/${relative}`;
    }
  },
});

const html = readme ? marked(readme) : null;
---

<StarlightPage frontmatter={{ title }}>
  <div class="mb-6 flex flex-col items-start gap-4">
    <LinkButton href={repo} icon="github" target="_blank">
      View source on GitHub
    </LinkButton>
    {
      hasMods && (
        <LinkCard
          href={`/printers/${id}/mods/`}
          title={`${title} Mods`}
          description={`Community-contributed modifications for the ${title}.`}
        />
      )
    }
  </div>

  {
    html ? (
      <div class="printer-readme" set:html={html} />
    ) : (
      <p class="text-gray-3 italic">README could not be loaded.</p>
    )
  }
</StarlightPage>

<style>
  .printer-readme :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 0.25rem;
  }

  .printer-readme :global(h1) {
    font-size: var(--sl-text-h3);
  }

  .printer-readme :global(h2) {
    font-size: var(--sl-text-h4);
  }
</style>
