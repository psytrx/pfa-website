---
import { getCollection } from "astro:content";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { LinkButton } from "@astrojs/starlight/components";

export async function getStaticPaths() {
  const printers = await getCollection("printers");
  return printers.flatMap((printer) => {
    const pdfUrl = printer.data.documentation_pdf;
    if (!pdfUrl) return [];

    return [
      {
        params: { id: printer.id },
        props: {
          title: printer.data.title,
          pdfUrl,
          githubUrl: printer.data.github.url,
        },
      },
    ];
  });
}

const { title, pdfUrl, githubUrl } = Astro.props;
---

<StarlightPage frontmatter={{ title: `${title} Documentation` }}>
  <div class="space-y-8">
    <LinkButton
      href={githubUrl}
      icon="github"
      target="_blank"
      variant="secondary"
    >
      View on GitHub
    </LinkButton>

    <object data={pdfUrl} type="application/pdf" class="h-[90vh] w-full">
      <p>
        Your browser does not support embedded PDFs.
        <a href={pdfUrl} download>Download the manual</a> instead.
      </p>
    </object>
  </div>
</StarlightPage>
