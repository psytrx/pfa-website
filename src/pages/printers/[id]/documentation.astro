---
import { getCollection } from "astro:content";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

export async function getStaticPaths() {
  const printers = await getCollection("printers");
  return printers
    .filter((p) => p.data.documentation_pdf)
    .map((p) => ({
      params: { id: p.id },
      props: { title: p.data.title, pdfPath: p.data.documentation_pdf },
    }));
}

const { title, pdfPath } = Astro.props;
---

<StarlightPage frontmatter={{ title: `${title} Documentation` }}>
  <object data={pdfPath} type="application/pdf" class="h-[90vh] w-full">
    <p>
      Your browser does not support embedded PDFs.
      <a href={pdfPath} download>Download the manual</a> instead.
    </p>
  </object>
</StarlightPage>
