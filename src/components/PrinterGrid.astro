---
import { getCollection } from "astro:content";
import { Card, CardGrid, LinkButton } from "@astrojs/starlight/components";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { printerImagePaths, type PrinterImagePath } from "../content/printers";
import crucibleHero from "../assets/printers/crucible-hero.png";
import doubleDragonHero from "../assets/printers/double-dragon-hero.png";
import duelingZeroHero from "../assets/printers/dueling-zero-hero.png";
import fZeroHero from "../assets/printers/f-zero-hero.png";
import hexZeroHero from "../assets/printers/hex-zero-hero.png";
import micronHero from "../assets/printers/micron-hero.png";
import pandorasBoxHero from "../assets/printers/pandoras-box-hero.png";
import saladForkHero from "../assets/printers/salad-fork-hero.png";
import tinyMHero from "../assets/printers/tiny-m-hero.png";
import tinyTHero from "../assets/printers/tiny-t-hero.png";
import triZeroHero from "../assets/printers/tri-zero-hero.png";

const printers = await getCollection("printers");

const printerImages = {
  [printerImagePaths.crucible]: crucibleHero,
  [printerImagePaths.doubleDragon]: doubleDragonHero,
  [printerImagePaths.duelingZero]: duelingZeroHero,
  [printerImagePaths.fZero]: fZeroHero,
  [printerImagePaths.hexZero]: hexZeroHero,
  [printerImagePaths.micron]: micronHero,
  [printerImagePaths.pandorasBox]: pandorasBoxHero,
  [printerImagePaths.saladFork]: saladForkHero,
  [printerImagePaths.tinyM]: tinyMHero,
  [printerImagePaths.tinyT]: tinyTHero,
  [printerImagePaths.triZero]: triZeroHero,
} satisfies Record<PrinterImagePath, ImageMetadata>;

const categories = {
  "scratch-builds": "Scratch Builds",
  "v0-mods": "V0 Mods",
  "barely-bigger": "Barely Bigger Mini Printers",
} as const;

const grouped = Object.entries(categories).map(([key, label]) => ({
  label,
  items: printers.filter((p) => p.data.category === key),
}));
---

<div class="grid gap-16">
  {
    grouped.map(({ label, items }) => (
      <section class="grid gap-8">
        <h2>{label}</h2>

        <CardGrid>
          {items.map(({ id, data }) => (
            <Card title={data.title}>
              <div class="flex flex-col items-center gap-4">
                <p class="mb-4 w-full text-left text-balance text-(--sl-color-gray-3) italic">
                  {data.subline}
                </p>

                <a href={`/printers/${id}`}>
                  <Image
                    src={printerImages[data.image]}
                    alt={data.title}
                    layout="constrained"
                    width="800"
                    class="aspect-square object-contain"
                  />
                </a>

                <p class="text-center text-balance">{data.description}</p>

                <LinkButton href={`/printers/${id}`} variant="secondary">
                  View printer details
                </LinkButton>
              </div>
            </Card>
          ))}
        </CardGrid>
      </section>
    ))
  }
</div>
