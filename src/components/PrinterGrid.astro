---
import { getCollection } from "astro:content";
import { Card, CardGrid, LinkButton } from "@astrojs/starlight/components";
import { Image } from "astro:assets";

const printers = await getCollection("printers");
const sorted = printers.sort((a, b) => a.data.order - b.data.order);

const categories: Record<string, string> = {
  "scratch-builds": "Scratch Builds",
  "v0-mods": "V0 Mods",
  "barely-bigger": "Barely Bigger Mini Printers",
};

const grouped = Object.entries(categories).map(([key, label]) => ({
  label,
  items: sorted.filter((p) => p.data.category === key),
}));
---

<div class="grid gap-16">
  {
    grouped.map(({ label, items }) => (
      <section class="grid gap-8">
        <h2>{label}</h2>

        <CardGrid>
          {items.map(({ id, data }) => (
            <Card title={data.title}>
              <p class="text-balance text-(--sl-color-gray-4) italic">
                {data.subline}
              </p>

              <Image
                src={data.image}
                alt={data.title}
                layout="constrained"
                width="800"
                class="aspect-square object-contain"
              />

              <div class="text-center">
                <p class="text-balance">{data.description}</p>

                <LinkButton href={`/printers/${id}`} variant="secondary">
                  View printer details
                </LinkButton>
              </div>
            </Card>
          ))}
        </CardGrid>
      </section>
    ))
  }
</div>
