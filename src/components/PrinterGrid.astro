---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const printers = await getCollection("printers");
const sorted = printers.sort((a, b) => a.data.order - b.data.order);

const categories: Record<string, string> = {
  "scratch-builds": "Scratch Builds",
  "v0-mods": "V0 Mods",
  "barely-bigger": "Barely Bigger Mini Printers",
};

const grouped = Object.entries(categories).map(([key, label]) => ({
  label,
  items: sorted.filter((p) => p.data.category === key),
}));
---

<div class="grid gap-8">
  {
    grouped.map(({ label, items }) => (
      <section>
        <h2>{label}</h2>
        <div class="grid grid-cols-[repeat(auto-fit,minmax(min(50vw,26rem),1fr))] gap-8">
          {items.map(({ id, data }) => (
            <a
              href={`/printers/${id}`}
              class="border-gray-5 hover:border-gray-2 flex flex-col overflow-hidden rounded-lg border text-inherit no-underline transition-colors duration-200"
            >
              <Image
                src={data.image}
                alt={data.title}
                widths={[450]}
                sizes="450px"
                class="bg-gray-6 aspect-[3/2] w-full object-contain"
              />
              <div class="flex flex-col gap-4 p-4">
                <h3 class="m-0 mb-1 text-xl">{data.title}</h3>
                <p class="text-gray-2 m-0 mb-4 text-lg text-balance italic">
                  {data.subline}
                </p>
                <p class="text-gray-2 m-0 text-sm">{data.description}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))
  }
</div>
