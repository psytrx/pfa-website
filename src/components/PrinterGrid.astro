---
import { getCollection } from "astro:content";
import { Card, CardGrid, LinkButton } from "@astrojs/starlight/components";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

const printers = await getCollection("printers");

const printerImages = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/printers/*-hero.png",
);

function loadPrinterImage(id: string) {
  const path = `../assets/printers/${id}-hero.png`;
  const loadImage = printerImages[path];
  if (!loadImage) {
    throw new Error(`Printer image not found: ${path}`);
  }
  return loadImage();
}

const categories = {
  "scratch-builds": "Scratch Builds",
  "v0-mods": "V0 Mods",
  "barely-bigger": "Barely Bigger Mini Printers",
} as const;

const grouped = Object.entries(categories).map(([key, label]) => ({
  label,
  items: printers.filter((p) => p.data.category === key),
}));
---

<div class="grid gap-16">
  {
    grouped.map(({ label, items }) => (
      <section class="grid gap-8">
        <h2>{label}</h2>

        <CardGrid>
          {items.map(({ id, data }) => {
            const developer = new URL(data.github.url).pathname
              .split("/")
              .filter(Boolean)[0];

            return (
              <Card title={data.title}>
                <div class="flex flex-col items-center gap-4">
                  <p class="mb-4 w-full text-left text-balance text-(--sl-color-gray-3) italic">
                    {data.subline}
                  </p>

                  <a href={`/printers/${id}`}>
                    <Image
                      src={loadPrinterImage(id)}
                      alt={data.title}
                      layout="constrained"
                      width="800"
                      class="aspect-square object-contain"
                    />
                  </a>

                  <p class="text-center text-balance">{data.description}</p>

                  <p class="text-sm text-(--sl-color-gray-3)">
                    Developer:{" "}
                    <a href={`https://github.com/${developer}`}>{developer}</a>
                  </p>

                  <LinkButton href={`/printers/${id}`} variant="secondary">
                    View printer details
                  </LinkButton>
                </div>
              </Card>
            );
          })}
        </CardGrid>
      </section>
    ))
  }
</div>
