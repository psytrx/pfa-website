---
import { LinkCard, CardGrid } from "@astrojs/starlight/components";

interface Props {
  printerId: string;
  mods: {
    id: string;
    name: string;
    author: string;
    description: string | null;
  }[];
}

const { printerId, mods } = Astro.props;

const byAuthor = mods.reduce<Record<string, typeof mods>>((acc, mod) => {
  const key = mod.author || "Other";
  (acc[key] ??= []).push(mod);
  return acc;
}, {});

const sortedAuthors = Object.keys(byAuthor).sort((a, b) => {
  if (a === "Other") return 1;
  if (b === "Other") return -1;
  return a.localeCompare(b);
});
---

<div class="mod-grid">
  {sortedAuthors.map((author) => (
    <section>
      <h3>{author}</h3>
      <CardGrid>
        {byAuthor[author].map((mod) => (
          <LinkCard
            title={mod.name}
            href={`/printers/${printerId}/mods/${mod.id}/`}
            description={mod.description || undefined}
            class='max-w-12'
          />
        ))}
      </CardGrid>
    </section>
  ))}
</div>

<style>
  .mod-grid {
    display: grid;
    gap: 2rem;
  }

  .mod-grid h3 {
    font-size: var(--sl-text-h4);
    margin: 0;
    border-bottom: 1px solid var(--sl-color-gray-5);
    padding-bottom: 0.5rem;
  }
</style>
