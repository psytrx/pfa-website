---
import { LinkCard, CardGrid } from "@astrojs/starlight/components";

interface Props {
  printerId: string;
  mods: {
    id: string;
    name: string;
    author: string;
    description: string | null;
  }[];
}

const { printerId, mods } = Astro.props;

const modsByAuthor = mods.reduce<Record<string, typeof mods>>((acc, mod) => {
  const key = mod.author || "Other";
  (acc[key] ??= []).push(mod);
  return acc;
}, {});

const sortedAuthors = Object.keys(modsByAuthor).sort((a, b) => {
  if (a === "Other") return 1;
  if (b === "Other") return -1;
  return a.localeCompare(b);
});
---

<div class="grid gap-8">
  {
    sortedAuthors.map((author) => (
      <section>
        <h3>{author}</h3>

        <CardGrid>
          {modsByAuthor[author].map((mod) => (
            <LinkCard
              title={mod.name}
              href={`/printers/${printerId}/mods/${mod.id}/`}
              description={mod.description || undefined}
            />
          ))}
        </CardGrid>
      </section>
    ))
  }
</div>
