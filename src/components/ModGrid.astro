---
import { Card, CardGrid, LinkButton } from "@astrojs/starlight/components";
import { Image } from "astro:assets";

interface Props {
  printerId: string;
  mods: {
    id: string;
    name: string;
    author: string;
    description: string | null;
    thumbnail?: string | null;
  }[];
}

const { printerId, mods } = Astro.props;

const sortedMods = [...mods].sort((a, b) => {
  const authorA = a.author || "Other";
  const authorB = b.author || "Other";
  if (authorA === "Other") return authorB === "Other" ? 0 : 1;
  if (authorB === "Other") return -1;
  return authorA.localeCompare(authorB);
});
---

<CardGrid>
  {
    sortedMods.map((mod, i) => (
      <Card title={mod.name}>
        <div class="flex flex-col items-start gap-2">
          <p class="text-sm text-(--sl-color-gray-3) italic">
            by {mod.author || "Other"}
          </p>

          {mod.thumbnail && (
            <a href={`/printers/${printerId}/mods/${mod.id}/`}>
              <Image
                src={mod.thumbnail}
                alt={mod.name}
                width={640}
                height={360}
                format="webp"
                class="aspect-video w-full rounded object-cover"
                loading={i <= 3 ? "eager" : "lazy"}
              />
            </a>
          )}

          <p class="text-sm text-(--sl-color-gray-3)">
            {mod.description ?? "No description available."}
          </p>

          <LinkButton
            href={`/printers/${printerId}/mods/${mod.id}/`}
            variant="secondary"
          >
            View mod details
          </LinkButton>
        </div>
      </Card>
    ))
  }
</CardGrid>
