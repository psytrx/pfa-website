---
import { Card, CardGrid, LinkButton } from "@astrojs/starlight/components";

interface Props {
  printerId: string;
  mods: {
    id: string;
    name: string;
    author: string;
    description: string | null;
    thumbnail?: string | null;
  }[];
}

const { printerId, mods } = Astro.props;

const modsByAuthor = mods.reduce<Record<string, typeof mods>>((acc, mod) => {
  const key = mod.author || "Other";
  (acc[key] ??= []).push(mod);
  return acc;
}, {});

const sortedAuthors = Object.keys(modsByAuthor).sort((a, b) => {
  if (a === "Other") return 1;
  if (b === "Other") return -1;
  return a.localeCompare(b);
});
---

<div class="grid gap-8">
  {
    sortedAuthors.map((author) => (
      <section>
        <h3>{author}</h3>

        <CardGrid>
          {modsByAuthor[author]?.map((mod) => (
            <Card title={mod.name}>
              <div class="flex flex-col items-start gap-2">
                {mod.thumbnail && (
                  <a href={`/printers/${printerId}/mods/${mod.id}/`}>
                    <img
                      src={mod.thumbnail}
                      alt={mod.name}
                      class="aspect-video w-full rounded object-cover"
                      loading="lazy"
                    />
                  </a>
                )}

                <p class="text-sm text-(--sl-color-gray-3)">
                  {mod.description ?? "No description available."}
                </p>

                <LinkButton
                  href={`/printers/${printerId}/mods/${mod.id}/`}
                  variant="secondary"
                >
                  View mod details
                </LinkButton>
              </div>
            </Card>
          ))}
        </CardGrid>
      </section>
    ))
  }
</div>
